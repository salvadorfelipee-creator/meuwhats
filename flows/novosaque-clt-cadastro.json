                    "title": "Nubank"
                  },
                  {
                    "id": "Inter",
                    "title": "Inter"
                  },
                  {
                    "id": "C6 Bank",
                    "title": "C6 Bank"
                  },
                  {
                    "id": "PagBank",
                    "title": "PagBank"
                  },
                  {
                    "id": "Mercado Pago",
                    "title": "Mercado Pago"
                  },
                  {
                    "id": "PicPay",
                    "title": "PicPay"
                  },
                  {
                    "id": "Banco Original",
                    "title": "Banco Original"
                  },
                  {
                    "id": "Sicoob",
                    "title": "Sicoob"
                  },
                  {
                    "id": "Sicredi",
                    "title": "Sicredi"
                  },
                  {
                    "id": "Safra",
                    "title": "Safra"
                  },
                  {
                    "id": "BTG Pactual",
                    "title": "BTG Pactual"
                  }
                ]
              },
              {
                "type": "Dropdown",
                "name": "tipo_conta",
                "label": "Tipo de conta",
                "required": false,
                "data-source": [
                  {
                    "id": "Corrente",
                    "title": "Corrente"
                  },
                  {
                    "id": "Poupança",
                    "title": "Poupança"
                  },
                  {
                    "id": "Salário",
                    "title": "Salário"
                  }
                ]
              },
              {
                "type": "TextInput",
                "name": "agencia",
                "label": "Agência",
                "required": false
              },
              {
                "type": "TextInput",
                "name": "conta",
                "label": "Número da conta",
                "required": false
              },
              {
                "type": "TextInput",
                "name": "digito_conta",
                "label": "Dígito da conta",
                "required": false
              },
              {
                "type": "TextInput",
                "name": "email_rh",
                "label": "E-mail do RH da sua empresa",
                "input-type": "email",
                "required": true
              },
              {
                "type": "TextInput",
                "name": "telefone_rh",
                "label": "Telefone do RH da sua empresa",
                "input-type": "phone",
                "required": true
              },
              {
                "type": "Footer",
                "label": "Enviar",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "nome": "${data.nome}",
                    "data_nascimento": "${data.data_nascimento}",
                    "genero": "${data.genero}",
                    "profissao": "${data.profissao}",
                    "email": "${data.email}",
                    "celular": "${data.celular}",
                    "cep": "${data.cep}",
                    "rua": "${data.rua}",
                    "numero": "${data.numero}",
                    "bairro": "${data.bairro}",
                    "cidade": "${data.cidade}",
                    "uf": "${data.uf}",
                    "forma_desembolso": "${form.forma_desembolso}",
                    "pix_tipo": "${form.pix_tipo}",
                    "pix_chave": "${form.pix_chave}",
                    "banco": "${form.banco}",
                    "tipo_conta": "${form.tipo_conta}",
                    "agencia": "${form.agencia}",
                    "conta": "${form.conta}",
                    "digito_conta": "${form.digito_conta}",
                    "email_rh": "${form.email_rh}",
                    "telefone_rh": "${form.telefone_rh}"
                  }
                }
              }
