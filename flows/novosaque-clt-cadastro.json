    {
      "id": "DESEMBOLSO",
      "title": "Como receber",
      "terminal": true,
      "data": {
        "nome": {
          "type": "string",
          "__example__": "Maria da Silva"
        },
        "data_nascimento": {
          "type": "string",
          "__example__": "1990-01-01"
        },
        "genero": {
          "type": "string",
          "__example__": "F"
        },
        "profissao": {
          "type": "string",
          "__example__": "Vendedora"
        },
        "email": {
          "type": "string",
          "__example__": "maria@exemplo.com"
        },
        "celular": {
          "type": "string",
          "__example__": "47999998888"
        },
        "cep": {
          "type": "string",
          "__example__": "88000000"
        },
        "rua": {
          "type": "string",
          "__example__": "Rua Exemplo"
        },
        "numero": {
          "type": "string",
          "__example__": "100"
        },
        "bairro": {
          "type": "string",
          "__example__": "Centro"
        },
        "cidade": {
          "type": "string",
          "__example__": "Camboriu"
        },
        "uf": {
          "type": "string",
          "__example__": "SC"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "form_desembolso",
            "children": [
              {
                "type": "RadioButtonsGroup",
                "name": "forma_desembolso",
                "label": "Como você quer receber o valor?",
                "required": true,
                "data-source": [
                  {
                    "id": "PIX",
                    "title": "PIX"
                  },
                  {
                    "id": "CONTA",
                    "title": "Conta bancária"
                  }
                ]
              },
              {
                "type": "Dropdown",
                "name": "pix_tipo",
                "label": "Tipo de chave PIX",
                "required": false,
                "data-source": [
                  {
                    "id": "CPF (o meu)",
                    "title": "CPF (o meu)"
                  },
                  {
                    "id": "E-mail",
                    "title": "E-mail"
                  },
                  {
                    "id": "Telefone",
                    "title": "Telefone"
                  },
                  {
                    "id": "Chave aleatória",
                    "title": "Chave aleatória"
                  }
                ]
              },
              {
                "type": "TextInput",
                "name": "pix_chave",
                "label": "Chave PIX",
                "required": false
              },
              {
                "type": "Dropdown",
                "name": "banco",
                "label": "Banco",
                "required": false,
                "data-source": [
                  {
                    "id": "Banco do Brasil",
                    "title": "Banco do Brasil"
                  },
                  {
                    "id": "Santander",
                    "title": "Santander"
                  },
