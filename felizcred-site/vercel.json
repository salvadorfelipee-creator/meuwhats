{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/app-teste/",
      "destination": "/app/",
      "permanent": false
    },
    {
      "source": "/cotacerta/",
      "destination": "https://www.cotacertaseguros.com.br/",
      "permanent": true
    },
    {
      "source": "/cotacerta/:path*",
      "destination": "https://www.cotacertaseguros.com.br/:path*",
      "permanent": true
    }
  ]
}
